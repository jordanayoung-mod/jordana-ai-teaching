    {
      "id": "6e01f114-b194-45f7-8586-741455a5dd59",
      "name": "Check Booking Hours",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        192
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const zone = 'Asia/Jerusalem';\nconst p = $json.payload || {};\nconst raw = String(p.session_start || p.start || '');\nconst mins = Number(p.duration_minutes || 60);\nconst reasons = [];\nconst result = { ...$json };\nconst start = DateTime.fromISO(raw, { zone }).setZone(zone);\nif (!raw || !start.isValid) {\n  reasons.push('missing or invalid session_start');\n} else {\n  const end = start.plus({ minutes: mins });\n  const wd = start.weekday;\n  const s = start.hour * 60 + start.minute;\n  const e = s + mins;\n  if (![7, 1, 2, 3, 4].includes(wd)) reasons.push('not Sunday to Thursday');\n  if (!start.hasSame(end, 'day')) reasons.push('runs past midnight');\n  if (s < 11 * 60 || e > 20 * 60) reasons.push('outside 11:00 to 20:00 Israel time');\n  if (s < 12 * 60 + 30 && e > 12 * 60) reasons.push('overlaps the 12:00 to 12:30 lunch break');\n  if (wd === 1 && s < 18 * 60 + 30 && e > 16 * 60 + 30) reasons.push('overlaps the Monday 16:30 to 18:30 block');\n  if (start < DateTime.fromISO('2026-11-29T00:00:00', { zone })) reasons.push('before bookings open (week of 29 November 2026)');\n  result.start_iso = start.toISO();\n  result.end_iso = end.toISO();\n}\nresult.within_hours = reasons.length === 0;\nresult.hours_problem = reasons.join('; ');\nreturn { json: result };"
      }
    },
