    {
      "id": "62aee9a9-27b9-42eb-b554-4a975480a2a9",
      "name": "Count Clashes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const base = $('Check Booking Hours').first().json;\nconst clashes = $input.all().filter(i => i.json && i.json.id && i.json.status !== 'cancelled' && i.json.transparency !== 'transparent');\nreturn [{ json: { ...base, clash_count: clashes.length, clash_titles: clashes.map(c => c.json.summary || 'busy').join(', '), slot_free: clashes.length === 0 } }];"
      }
